DATABASE_URL="postgres://postgres:postgres@localhost:5432/order_fulfillment"
# APP_URL=https://shopify-dev-tunnel.xubitar.com
APP_URL=http://localhost:3000
AUTH_URL=${APP_URL}
NEXTAUTH_URL=${APP_URL}
SHOPIFY_APP_URL=${APP_URL}/api/shopify-auth
AUTH_SECRET=
AUTH_TRUST_HOST=true
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_fulfillments,write_fulfillments,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders,read_inventory,write_inventory,read_locations,write_locations,read_customers,read_publications,write_publications
EXTRA_SCOPES=read_all_orders
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=