{
  "name": "order-fulfillment",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:setup && next build",
    "prisma:setup": "prisma generate && prisma migrate deploy",
    "start": "next start -p 9090",
    "worker:orders-sync": "tsx workers/order-sync.worker.ts",
    "worker:product-sync": "tsx workers/product-sync.worker.ts",
    "worker:decoration-digest": "tsx workers/decoration-digest.worker.ts",
    "worker:background": "tsx workers/background.worker.ts",
    "backfill:order-line-items": "tsx scripts/enqueue-backfill-order-line-items.ts",
    "backfill:category-full-names": "tsx scripts/backfill-category-full-names.ts",
    "register-webhooks": "tsx scripts/register-shopify-webhooks.ts",
    "lint": "eslint",
    "pm2": "pm2",
    "pm2:start": "pm2 start .pm2.config.js",
    "pm2:stop": "pm2 stop .pm2.config.js",
    "pm2:restart": "pm2 restart .pm2.config.js",
    "pm2:delete": "pm2 delete .pm2.config.js",
    "pm2:logrotate:install": "pm2 install pm2-logrotate || true",
    "pm2:logrotate:config": "pm2 set pm2-logrotate:max_size 10M && pm2 set pm2-logrotate:retain 7 && pm2 set pm2-logrotate:compress true && pm2 set pm2-logrotate:rotateInterval '0 0 * * *'",
    "pm2:setup": "npm run pm2:logrotate:install && npm run pm2:logrotate:config && npm run pm2:start",
    "pm2:logrotate:remove": "pm2 uninstall pm2-logrotate",
    "pm2:logrotate:disable": "pm2 set pm2-logrotate:enabled false"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "isomorphic-dompurify": "^3.23.0",
    "moment-timezone": "^0.6.2",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-toastify": "^11.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "pm2": "^6.0.14",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "esbuild@0.27.7": true,
    "prisma@7.8.0": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true
  }
}
