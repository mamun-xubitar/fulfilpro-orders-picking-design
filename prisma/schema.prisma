// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String               @id @default(uuid())
  name                     String
  email                    String               @unique
  password                 String
  role                     String               @default("admin")
  active                   Boolean              @default(true)
  isTempPassword           Boolean              @default(true)
  isLoggedIn               Boolean              @default(false)
  lastLoginAt              DateTime?
  lastLogoutAt             DateTime?
  staffAccessDays          Json                 @default("[\"Mon\",\"Tue\",\"Wed\",\"Thu\",\"Fri\"]")
  staffAccessStart         String               @default("08:00")
  staffAccessEnd           String               @default("16:00")
  sessionTimeoutMinutes    Int                  @default(30)
  inactivityTimeoutMinutes Int?
  allowedStoreIds          Json                 @default("[]")
  loginAutoApproveDate     String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  staffLoginApprovals      StaffLoginApproval[]
  notifications            Notification[]

  @@index([email])
  @@index([active])
  @@index([isLoggedIn])
}

model Store {
  id                          String               @id @default(uuid())
  storeDomain                 String               @unique
  name                        String?
  accessToken                 String?
  url                         String?
  email                       String?
  logoPath                    String?
  status                      String               @default("pending")
  clientId                    String
  appId                       String?
  clientSecret                String
  appManagementToken          String?
  appManagementTokenExpiresAt DateTime?
  partnerStoreId              String?
  lastSyncedAt                DateTime?
  lastProductSyncedAt         DateTime?
  partnerStore                Store?               @relation("PartnerStores", fields: [partnerStoreId], references: [id], onDelete: SetNull)
  childStores                 Store[]              @relation("PartnerStores")
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  orders                      Order[]
  shipmentTrackings           ShipmentTracking[]
  products                    Product[]
  orderLineItems              OrderLineItem[]
  supplierCollections         SupplierCollection[]

  @@index([status])
  @@index([partnerStoreId])
}

model Order {
  id                     String                     @id @default(uuid())
  number                 String
  cusName                String
  cusEmail               String?
  address                String?
  address2               String?
  phone                  String?
  city                   String?
  canceledAt             DateTime?
  closedAt               DateTime?
  canceled               Boolean                    @default(false)
  closed                 Boolean                    @default(false)
  state                  String?
  zip                    String?
  fulfillmentStatus      String?
  boarcode               String?
  currencyCode           String?
  note                   String?
  lineItems              Json
  shippingLines          Json?
  fulfillmentItems       Json?
  price                  Float
  country                String?
  storeId                String
  orderedAt              DateTime?
  store                  Store                      @relation(fields: [storeId], references: [id])
  messages               OrderMessage[]
  notes                  OrderNote[]
  packingConfirmations   OrderPackingConfirmation[]
  pickingSlipPrints      OrderPickingSlipPrint[]
  backInStockRequests    BackInStockRequest[]
  stockAdjustment        OrderStockAdjustment?
  decorationAttachment   OrderDecorationAttachment?
  lineItemDecorations    LineItemDecoration[]
  lineItemAssignments    LineItemAssignment[]
  lineItemWorks          LineItemWork[]
  decorationEditRequests DecorationEditRequest[]
  shipmentTrackings      ShipmentTracking[]
  orderLineItems         OrderLineItem[]
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@unique([storeId, number])
}

model LineItemDecoration {
  id             String   @id @default(uuid())
  orderId        String
  lineItemId     String
  isEmbroidery   Boolean  @default(false)
  isPrint        Boolean  @default(false)
  manualOverride Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, lineItemId])
  @@index([orderId])
}

model LineItemAssignment {
  id             String    @id @default(uuid())
  orderId        String
  orderNumber    String
  lineItemId     String
  assigneeId     String
  assigneeName   String
  assigneeEmail  String
  assigneeRole   String
  category       String?
  dueDate        DateTime?
  assignedById   String?
  assignedByName String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, lineItemId, assigneeId])
  @@index([orderId])
  @@index([assigneeId])
}

model LineItemWork {
  id           String    @id @default(uuid())
  orderId      String
  orderNumber  String
  lineItemId   String
  workerId     String
  workerName   String
  workerEmail  String
  workerRole   String
  category     String
  quantityDone Int
  comments     Json      @default("[]")
  digestSentAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([workerId])
  @@index([digestSentAt])
}

model DecorationEditRequest {
  id               String    @id @default(uuid())
  orderId          String
  orderNumber      String
  lineItemId       String
  requestedById    String
  requestedByName  String
  requestedByEmail String
  requestedByRole  String
  reason           String
  status           String    @default("pending")
  adminTargets     Json
  approveToken     String    @unique
  rejectToken      String    @unique
  approvedById     String?
  approvedByName   String?
  approvedAt       DateTime?
  rejectedById     String?
  rejectedByName   String?
  rejectedAt       DateTime?
  completedAt      DateTime?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([lineItemId])
  @@index([status])
  @@index([approveToken])
  @@index([rejectToken])
}

model OrderPackingConfirmation {
  id                     String    @id @default(uuid())
  orderId                String
  orderNumber            String
  lines                  Json
  notifyRecipients       Json?
  notifyMessage          String?
  pickerId               String?
  pickerName             String?
  pickerEmail            String?
  confirmedAt            DateTime  @default(now())
  canceledAt             DateTime?
  canceledById           String?
  canceledByName         String?
  canceledByEmail        String?
  cancelNotifyRecipients Json?
  cancelNotifyMessage    String?
  order                  Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([confirmedAt])
  @@index([canceledAt])
}

model OrderPickingSlipPrint {
  id          String   @id @default(uuid())
  orderId     String
  orderNumber String
  items       Json
  pickerId    String?
  pickerName  String?
  pickerEmail String?
  printedAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([printedAt])
}

model OrderItemPickingMetadata {
  id        String   @id @default(uuid())
  storeId   String
  productId String?
  variantId String?
  sku       String?
  location  String?
  remark    String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([productId])
  @@index([variantId])
  @@index([sku])
}

model OrderStockAdjustment {
  id             String   @id @default(uuid())
  orderId        String   @unique
  orderNumber    String
  status         String   @default("pending")
  items          Json
  lastEventType  String
  lastEventAt    DateTime @default(now())
  managedById    String?
  managedByName  String?
  managedByEmail String?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([lastEventAt])
}

model OrderDecorationAttachment {
  id              String   @id @default(uuid())
  orderId         String   @unique
  files           Json     @default("[]")
  customerDesign  Json     @default("[]")
  customerRemarks String?
  photos          Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model BackInStockRequest {
  id                String               @id @default(uuid())
  orderId           String
  orderNumber       String
  requesterId       String
  requesterName     String
  requesterEmail    String
  status            String               @default("pending")
  items             Json
  requestMessage    String?
  requesterViewedAt DateTime?
  lastAdminUpdateAt DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  messages          BackInStockMessage[]

  @@index([orderId])
  @@index([requesterId])
  @@index([status])
  @@index([updatedAt])
}

model BackInStockMessage {
  id          String             @id @default(uuid())
  requestId   String
  senderId    String?
  senderName  String
  senderEmail String
  senderRole  String
  message     String
  status      String?
  createdAt   DateTime           @default(now())
  request     BackInStockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model OrderNote {
  id          String   @id @default(uuid())
  orderId     String
  note        String
  authorId    String?
  authorName  String?
  authorEmail String?
  editorId    String?
  editorName  String?
  editorEmail String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([authorEmail])
}

model OrderMessage {
  id          String           @id @default(uuid())
  orderId     String
  adminId     String?
  adminName   String
  adminEmail  String
  senderId    String?
  senderName  String?
  senderEmail String?
  type        OrderMessageType @default(orders)
  message     String
  createdAt   DateTime         @default(now())
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, type, createdAt])
  @@index([adminEmail])
}

enum OrderMessageType {
  orders
  picker
}

enum TaskStatus {
  PENDING
  COMPLETED
}

enum TaskDueType {
  STANDARD
  URGENT
  CUSTOM
}

enum TaskRecurrenceType {
  DAILY
  WEEKLY
}

model OrderSyncJob {
  id           String    @id @default(uuid())
  status       String    @default("queued")
  storeIds     Json?
  totalStores  Int       @default(0)
  totalFetched Int       @default(0)
  totalCreated Int       @default(0)
  totalUpdated Int       @default(0)
  failedStores Int       @default(0)
  error        String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([finishedAt])
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model Product {
  id               String            @id @default(uuid())
  storeId          String
  shopifyId        String
  title            String
  handle           String?
  vendor           String?
  productType      String?
  category         String?
  categoryId       String?
  status           ProductStatus     @default(ACTIVE)
  tags             String[]          @default([])
  imageUrl         String?
  descriptionHtml  String?
  images           Json?
  onlineStoreUrl   String?
  salesChannels    Json?
  totalInventory   Int               @default(0)
  soldQuantity     Int               @default(0)
  soldAmount       Decimal           @default(0) @db.Decimal(14, 2)
  shopifyCreatedAt DateTime?
  shopifyUpdatedAt DateTime?
  deletedAt        DateTime?
  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants         ProductVariant[]
  lineItems        OrderLineItem[]
  supplierLinks    SupplierProduct[]
  purchaseOrders   PurchaseOrder[]
  pricing          ProductPricing?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([storeId, shopifyId])
  @@index([storeId, status])
  @@index([vendor])
  @@index([productType])
  @@index([category])
  @@index([storeId, title])
  @@index([handle])
}

model ProductVariant {
  id                 String              @id @default(uuid())
  productId          String
  storeId            String
  shopifyId          String
  title              String?
  sku                String?
  price              Decimal             @default(0) @db.Decimal(14, 2)
  cost               Decimal?            @db.Decimal(14, 2)
  inventoryItemId    String?
  inventoryQuantity  Int                 @default(0)
  inventoryTracked   Boolean             @default(true)
  inventoryPolicy    String              @default("DENY")
  imageUrl           String?
  optionValues       Json?
  position           Int                 @default(0)
  soldQuantity       Int                 @default(0)
  soldAmount         Decimal             @default(0) @db.Decimal(14, 2)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  lineItems          OrderLineItem[]
  purchaseOrderItems PurchaseOrderItem[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([storeId, shopifyId])
  @@index([productId])
  @@index([sku])
  @@index([storeId])
}

model ProductPricing {
  id            String   @id @default(uuid())
  productId     String   @unique
  currencyCode  String   @default("AUD")
  exchangeRate  Decimal  @default(1) @db.Decimal(14, 6)
  buyingPrice   Decimal  @default(0) @db.Decimal(14, 2)
  freight       Decimal  @default(0) @db.Decimal(14, 2)
  misc          Decimal  @default(0) @db.Decimal(14, 2)
  marginPercent Decimal  @default(0) @db.Decimal(6, 2)
  tax           Decimal  @default(0) @db.Decimal(14, 2)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OrderLineItem {
  id               String          @id @default(uuid())
  orderId          String
  storeId          String
  lineItemId       String
  productShopifyId String?
  variantShopifyId String?
  productId        String?
  variantId        String?
  sku              String?
  title            String?
  quantity         Int
  refundedQuantity Int             @default(0)
  netQuantity      Int             @default(0)
  unitPrice        Decimal         @default(0) @db.Decimal(14, 2)
  netAmount        Decimal         @default(0) @db.Decimal(14, 2)
  orderedAt        DateTime?
  canceled         Boolean         @default(false)
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  store            Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([orderId, lineItemId])
  @@index([productId, orderedAt])
  @@index([variantId, orderedAt])
  @@index([storeId])
}

model ProductSyncJob {
  id           String    @id @default(uuid())
  status       String    @default("queued")
  storeIds     Json?
  totalStores  Int       @default(0)
  totalFetched Int       @default(0)
  totalCreated Int       @default(0)
  totalUpdated Int       @default(0)
  failedStores Int       @default(0)
  error        String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([finishedAt])
}

model AppSettings {
  id                                 String    @id @default("default")
  timezone                           String    @default("Australia/Sydney")
  staffAccessDays                    Json      @default("[\"Mon\",\"Tue\",\"Wed\",\"Thu\",\"Fri\"]")
  staffAccessStart                   String    @default("08:00")
  staffAccessEnd                     String    @default("16:00")
  sessionTimeoutMinutes              Int       @default(30)
  inactivityTimeoutMinutes           Int?
  googleEmail                        String?
  googleAccessToken                  String?
  googleRefreshToken                 String?
  googleTokenExpiresAt               DateTime?
  emailProvider                      String    @default("google")
  mailersendApiToken                 String?
  mailersendFromEmail                String?
  loginApprovalRecipientUserIds      Json      @default("[]")
  backInStockAdminRecipientUserIds   Json      @default("[]")
  stockAdjustmentRecipientUserIds    Json      @default("[]")
  fulfillmentRequestAllowedUserIds   Json      @default("[]")
  fulfillmentRequestDefaultUserIds   Json      @default("[]")
  pickingPackingAllowedUserIds       Json      @default("[]")
  pickingPackingDefaultUserIds       Json      @default("[]")
  directMessageAllowedUserIds        Json      @default("[]")
  directMessageDefaultUserIds        Json      @default("[]")
  backInStockRequesterUpdatesEnabled Boolean   @default(true)
  decorationDigestMode               String    @default("global_time")
  decorationDigestTime               String    @default("17:00")
  decorationDigestRecipientUserIds   Json      @default("[]")
  taskReminderTimes                  Json      @default("[\"08:00\",\"12:00\",\"16:00\"]")
  embroideryKeywords                 Json      @default("[\"embroider\",\"emb\"]")
  printKeywords                      Json      @default("[\"print\"]")
  seventrackApiKey                   String?
  trackingAutoRegisterEnabled        Boolean   @default(false)
  trackingPendingAlertDays           Int       @default(7)
  trackingPendingAlertUserIds        Json      @default("[]")
  trackingPickupReminderDays         Json      @default("[]")
  taskVisibilityByUser               Json      @default("{}")
  decorationCrossVisibilityEnabled   Boolean   @default(false)
  globalMarginPercent                Decimal   @default(0) @db.Decimal(6, 2)
  lowStockThreshold                  Int       @default(10)
  createdAt                          DateTime  @default(now())
  updatedAt                          DateTime  @updatedAt
}

model FulfillmentEditRequest {
  id               String    @id @default(uuid())
  orderId          String
  orderNumber      String
  fulfillmentId    String
  requestType      String
  requestedById    String
  requestedByName  String
  requestedByEmail String
  reason           String
  status           String    @default("pending")
  adminTargets     Json
  approveToken     String    @unique
  rejectToken      String    @unique
  approvedById     String?
  approvedByName   String?
  approvedAt       DateTime?
  rejectedById     String?
  rejectedByName   String?
  rejectedAt       DateTime?
  completedAt      DateTime?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([orderId])
  @@index([fulfillmentId])
  @@index([status])
  @@index([requestedById])
  @@index([approveToken])
  @@index([rejectToken])
}

model Notification {
  id               String    @id @default(uuid())
  recipientId      String
  type             String
  title            String
  body             String
  orderId          String?
  orderNumber      String?
  lineItemId       String?
  relatedRequestId String?
  taskId           String?
  actionable       Boolean   @default(false)
  actionStatus     String?
  readAt           DateTime?
  createdAt        DateTime  @default(now())
  recipient        User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([recipientId, readAt])
  @@index([relatedRequestId])
  @@index([taskId])
}

model StaffLoginApproval {
  id           String    @id @default(uuid())
  userId       String
  email        String
  status       String    @default("pending")
  approveToken String    @unique
  rejectToken  String    @unique
  expiresAt    DateTime
  approvedAt   DateTime?
  rejectedAt   DateTime?
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
}

model ShipmentTracking {
  id                   String    @id @default(uuid())
  orderId              String
  storeId              String
  orderNumber          String
  trackingNumber       String
  carrier              Int?
  registrationStatus   String    @default("registered")
  status               String?
  subStatus            String?
  lastEventAt          DateTime?
  lastEventDesc        String?
  lastEventLocation    String?
  events               Json?
  shippedAt            DateTime?
  registeredAt         DateTime?
  availableForPickupAt DateTime?
  deliveredAt          DateTime?
  pendingAlertSentAt   DateTime?
  pickupRemindersSent  Json      @default("[]")
  lastSyncedAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  order                Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  store                Store     @relation(fields: [storeId], references: [id])

  @@unique([orderId, trackingNumber])
  @@index([trackingNumber])
  @@index([status])
  @@index([registrationStatus])
}

model BackgroundJob {
  id         String    @id @default(uuid())
  type       String
  payload    Json?
  status     String    @default("queued")
  attempts   Int       @default(0)
  error      String?
  progress   Json?
  runAfter   DateTime?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@index([runAfter])
  @@index([createdAt])
}

model Task {
  id                   String        @id @default(uuid())
  title                String
  description          String
  status               TaskStatus    @default(PENDING)
  dueDate              DateTime
  dueType              TaskDueType   @default(CUSTOM)
  completedAt          DateTime?
  proofFiles           Json          @default("[]")
  assignerId           String
  assignerName         String
  assignerEmail        String
  assigneeId           String
  assigneeName         String
  assigneeEmail        String
  lastReadByAssignerAt DateTime?
  lastReadByAssigneeAt DateTime?
  recurrenceType       TaskRecurrenceType?
  recurrenceEndDate    DateTime?
  isRecurringParent    Boolean             @default(false)
  recurrenceStoppedAt  DateTime?
  nextOccurrenceAt     DateTime?
  parentTaskId         String?
  parent               Task?         @relation("TaskRecurrence", fields: [parentTaskId], references: [id], onDelete: SetNull)
  children             Task[]        @relation("TaskRecurrence")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  messages             TaskMessage[]

  @@index([assigneeId, status])
  @@index([assignerId])
  @@index([status, dueDate])
  @@index([createdAt])
  @@index([isRecurringParent, recurrenceStoppedAt, nextOccurrenceAt])
  @@index([parentTaskId])
}

model TaskMessage {
  id          String   @id @default(uuid())
  taskId      String
  senderId    String
  senderName  String
  senderEmail String
  message     String
  createdAt   DateTime @default(now())
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model CurrencyRate {
  id        String   @id @default(uuid())
  code      String   @unique
  rate      Decimal  @db.Decimal(14, 6)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id             String               @id @default(uuid())
  name           String
  contactEmail   String?
  poEmail        String
  description    String?
  products       SupplierProduct[]
  collections    SupplierCollection[]
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([name])
}

enum PurchaseOrderStatus {
  DRAFT
  REQUESTED
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id                  String              @id @default(uuid())
  number              Int                 @unique @default(autoincrement())
  supplierId          String
  supplierName        String
  poEmail             String
  productId           String
  productTitle        String
  status              PurchaseOrderStatus @default(REQUESTED)
  deliveryDate        DateTime?
  remark              String?
  createdById         String
  createdByName       String
  statusUpdatedById   String?
  statusUpdatedByName String?
  statusUpdatedAt     DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  supplier            Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  product             Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  items               PurchaseOrderItem[]

  @@index([productId, createdAt])
  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id              String          @id @default(uuid())
  purchaseOrderId String
  variantId       String?
  variantTitle    String
  sku             String?
  quantity        Int
  receivedQuantity Int            @default(0)
  purchaseOrder   PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
}

model SupplierProduct {
  id         String   @id @default(uuid())
  supplierId String
  productId  String
  linkedAt   DateTime @default(now())
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([productId, linkedAt])
}

model SupplierCollection {
  id           String   @id @default(uuid())
  supplierId   String
  storeId      String
  collectionId String
  title        String
  handle       String?
  createdAt    DateTime @default(now())
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([supplierId, storeId, collectionId])
  @@index([storeId, collectionId])
}
