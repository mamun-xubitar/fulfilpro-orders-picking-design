// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String               @id @default(uuid())
  name                     String
  email                    String               @unique
  password                 String
  role                     String               @default("admin")
  active                   Boolean              @default(true)
  isTempPassword           Boolean              @default(true)
  isLoggedIn               Boolean              @default(false)
  lastLoginAt              DateTime?
  lastLogoutAt             DateTime?
  staffAccessDays          Json                 @default("[\"Mon\",\"Tue\",\"Wed\",\"Thu\",\"Fri\"]")
  staffAccessStart         String               @default("08:00")
  staffAccessEnd           String               @default("16:00")
  sessionTimeoutMinutes    Int                  @default(30)
  inactivityTimeoutMinutes Int?
  allowedStoreIds          Json                 @default("[]")
  loginAutoApproveDate     String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  staffLoginApprovals      StaffLoginApproval[]
  notifications            Notification[]

  @@index([email])
  @@index([active])
  @@index([isLoggedIn])
}

model Store {
  id                          String                        @id @default(uuid())
  storeDomain                 String                        @unique
  name                        String?
  accessToken                 String?
  url                         String?
  email                       String?
  logoPath                    String?
  status                      String                        @default("pending")
  clientId                    String
  appId                       String?
  clientSecret                String
  appManagementToken          String?
  appManagementTokenExpiresAt DateTime?
  partnerStoreId              String?
  lastSyncedAt                DateTime?
  lastProductSyncedAt         DateTime?
  defaultMarginPercent        Decimal?                      @db.Decimal(6, 2)
  partnerStore                Store?                        @relation("PartnerStores", fields: [partnerStoreId], references: [id], onDelete: SetNull)
  childStores                 Store[]                       @relation("PartnerStores")
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  orders                      Order[]
  shipmentTrackings           ShipmentTracking[]
  products                    Product[]
  orderLineItems              OrderLineItem[]
  supplierProductListings     SupplierProductStoreListing[]
  webhookEvents               ShopifyWebhookEvent[]
  inventoryAllocations        InventoryAllocation[]
  processedFulfillments       ProcessedFulfillmentEvent[]
  processedRefunds            ProcessedRefundEvent[]
  locations                   StoreLocation[]
  invoiceSetting              StoreInvoiceSetting?
  shopifyCustomers            ShopifyCustomer[]
  invoices                    Invoice[]

  @@index([status])
  @@index([partnerStoreId])
}

model StoreInvoiceSetting {
  id                  String   @id @default(uuid())
  storeId             String   @unique
  storeName           String?
  businessName        String?
  email               String?
  websiteUrl          String?
  abn                 String?
  invoicePrefix       String?
  paymentInstructions String?
  accentColor         String?
  logoPath            String?
  ausTaxRate          Decimal  @default(11) @db.Decimal(5, 2)
  nzTaxRate           Decimal  @default(15) @db.Decimal(5, 2)
  defaultTerms        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  store               Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

/// A customer created in this system (not synced from Shopify). Invoices are made against these.
model Customer {
  id           String            @id @default(uuid())
  /// Human-readable customer code, shown as `C{code}`.
  code         Int               @unique @default(autoincrement())
  type         String?
  creditLimit  Decimal?          @db.Decimal(14, 2)
  /// Defaults for invoices made against this customer.
  currencyCode String            @default("AUD")
  taxRegion    String            @default("AU")
  contacts     CustomerContact[]
  addresses    CustomerAddress[]
  name         String
  company      String?
  email        String?
  phone        String?
  address      String?
  address2     String?
  city         String?
  state        String?
  zip          String?
  country      String?
  notes        String?
  invoices     Invoice[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([name])
  @@index([email])
}

model CustomerContact {
  id         String   @id @default(uuid())
  customerId String
  position   Int
  name       String
  email      String?
  phone      String?
  jobTitle   String?
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

/// A shipping address of a system customer. The billing address lives on `Customer` itself.
model CustomerAddress {
  id         String   @id @default(uuid())
  customerId String
  position   Int
  label      String?
  name       String
  phone      String?
  address    String?
  address2   String?
  city       String?
  state      String?
  zip        String?
  country    String?
  isDefault  Boolean  @default(false)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

/// Local copy of a Shopify store customer. Edits and deletes stay local; a re-sync leaves
/// `locallyEdited` rows alone and never resurrects soft-deleted ones. A null `shopifyCustomerId`
/// is a customer added by hand on the Shopify tab.
model ShopifyCustomer {
  id                String    @id @default(uuid())
  storeId           String
  shopifyCustomerId String?
  name              String
  company           String?
  email             String?
  phone             String?
  address           String?
  address2          String?
  city              String?
  state             String?
  zip               String?
  country           String?
  notes             String?
  ordersCount       Int       @default(0)
  totalSpent        Decimal   @default(0) @db.Decimal(14, 2)
  locallyEdited     Boolean   @default(false)
  deletedAt         DateTime?
  store             Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invoices          Invoice[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([storeId, shopifyCustomerId])
  @@index([storeId])
  @@index([name])
  @@index([email])
}

/// A manually created invoice. Bill-to / ship-to are snapshots, so deleting or merging the
/// linked customer never changes an issued invoice.
model Invoice {
  id                String            @id @default(uuid())
  invoiceNumber     String            @unique
  invoiceSequence   Int?
  storeId           String
  customerId        String?
  shopifyCustomerId String?
  billToName        String
  billToAddress     String?
  shipToName        String
  shipToAddress     String?
  /// Customer's order / PO reference.
  orderRef          String?
  lastEmailedAt     DateTime?
  issueDate         DateTime
  dueDate           DateTime?
  currencyCode      String            @default("AUD")
  taxRegion         String            @default("AU")
  taxRate           Decimal           @default(0) @db.Decimal(5, 2)
  shipping          Decimal           @default(0) @db.Decimal(14, 2)
  notes             String?
  terms             String?
  subTotal          Decimal           @default(0) @db.Decimal(14, 2)
  discountTotal     Decimal           @default(0) @db.Decimal(14, 2)
  taxTotal          Decimal           @default(0) @db.Decimal(14, 2)
  total             Decimal           @default(0) @db.Decimal(14, 2)
  amountPaid        Decimal           @default(0) @db.Decimal(14, 2)
  balance           Decimal           @default(0) @db.Decimal(14, 2)
  paymentStatus     String            @default("UNPAID")
  store             Store             @relation(fields: [storeId], references: [id])
  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shopifyCustomer   ShopifyCustomer?  @relation(fields: [shopifyCustomerId], references: [id], onDelete: SetNull)
  lineItems         InvoiceLineItem[]
  payments          InvoicePayment[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([storeId])
  @@index([customerId])
  @@index([shopifyCustomerId])
  @@index([paymentStatus])
  @@index([issueDate])
}

model InvoiceLineItem {
  id              String  @id @default(uuid())
  invoiceId       String
  position        Int
  variantId       String?
  title           String
  size            String?
  sku             String?
  qty             Int
  unitPrice       Decimal @db.Decimal(14, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  amount          Decimal @db.Decimal(14, 2)
  invoice         Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoicePayment {
  id          String   @id @default(uuid())
  invoiceId   String
  type        String
  paidOn      DateTime
  amount      Decimal  @db.Decimal(14, 2)
  person      String?
  description String?
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

model Order {
  id                     String                     @id @default(uuid())
  number                 Int
  cusName                String
  cusEmail               String?
  address                String?
  address2               String?
  phone                  String?
  city                   String?
  canceledAt             DateTime?
  closedAt               DateTime?
  canceled               Boolean                    @default(false)
  closed                 Boolean                    @default(false)
  state                  String?
  zip                    String?
  fulfillmentStatus      String?
  boarcode               String?
  currencyCode           String?
  note                   String?
  lineItems              Json
  shippingLines          Json?
  fulfillmentItems       Json?
  price                  Float
  country                String?
  storeId                String
  orderedAt              DateTime?
  labelPrintedAt         DateTime?
  currentSubtotalPrice   Decimal?                   @db.Decimal(14, 2)
  currentTotalDiscounts  Decimal?                   @db.Decimal(14, 2)
  currentTotalTax        Decimal?                   @db.Decimal(14, 2)
  currentTotalPrice      Decimal?                   @db.Decimal(14, 2)
  taxesIncluded          Boolean?
  amountPaid             Decimal?                   @db.Decimal(14, 2)
  paymentMethods         Json?
  invoiceNumber          String?
  invoiceSequence        Int?
  store                  Store                      @relation(fields: [storeId], references: [id])
  messages               OrderMessage[]
  notes                  OrderNote[]
  packingConfirmations   OrderPackingConfirmation[]
  pickingSlipPrints      OrderPickingSlipPrint[]
  backInStockRequests    BackInStockRequest[]
  stockAdjustment        OrderStockAdjustment?
  decorationAttachment   OrderDecorationAttachment?
  lineItemDecorations    LineItemDecoration[]
  lineItemAssignments    LineItemAssignment[]
  lineItemWorks          LineItemWork[]
  decorationEditRequests DecorationEditRequest[]
  shipmentTrackings      ShipmentTracking[]
  orderLineItems         OrderLineItem[]
  inventoryAllocations   InventoryAllocation[]
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@unique([storeId, number])
}

model LineItemDecoration {
  id             String   @id @default(uuid())
  orderId        String
  lineItemId     String
  isEmbroidery   Boolean  @default(false)
  isPrint        Boolean  @default(false)
  manualOverride Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, lineItemId])
  @@index([orderId])
}

model LineItemAssignment {
  id             String    @id @default(uuid())
  orderId        String
  orderNumber    String
  lineItemId     String
  assigneeId     String
  assigneeName   String
  assigneeEmail  String
  assigneeRole   String
  category       String?
  dueDate        DateTime?
  assignedById   String?
  assignedByName String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, lineItemId, assigneeId])
  @@index([orderId])
  @@index([assigneeId])
}

model LineItemWork {
  id           String    @id @default(uuid())
  orderId      String
  orderNumber  String
  lineItemId   String
  workerId     String
  workerName   String
  workerEmail  String
  workerRole   String
  category     String
  quantityDone Int
  comments     Json      @default("[]")
  digestSentAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([workerId])
  @@index([digestSentAt])
}

model DecorationEditRequest {
  id               String    @id @default(uuid())
  orderId          String
  orderNumber      String
  lineItemId       String
  requestedById    String
  requestedByName  String
  requestedByEmail String
  requestedByRole  String
  reason           String
  status           String    @default("pending")
  adminTargets     Json
  approveToken     String    @unique
  rejectToken      String    @unique
  approvedById     String?
  approvedByName   String?
  approvedAt       DateTime?
  rejectedById     String?
  rejectedByName   String?
  rejectedAt       DateTime?
  completedAt      DateTime?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([lineItemId])
  @@index([status])
  @@index([approveToken])
  @@index([rejectToken])
}

model OrderPackingConfirmation {
  id                     String    @id @default(uuid())
  orderId                String
  orderNumber            String
  lines                  Json
  notifyRecipients       Json?
  notifyMessage          String?
  pickerId               String?
  pickerName             String?
  pickerEmail            String?
  confirmedAt            DateTime  @default(now())
  canceledAt             DateTime?
  canceledById           String?
  canceledByName         String?
  canceledByEmail        String?
  cancelNotifyRecipients Json?
  cancelNotifyMessage    String?
  order                  Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([confirmedAt])
  @@index([canceledAt])
}

model OrderPickingSlipPrint {
  id          String   @id @default(uuid())
  orderId     String
  orderNumber String
  items       Json
  pickerId    String?
  pickerName  String?
  pickerEmail String?
  printedAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([printedAt])
}

model OrderItemPickingMetadata {
  id        String   @id @default(uuid())
  storeId   String
  productId String?
  variantId String?
  sku       String?
  location  String?
  remark    String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([productId])
  @@index([variantId])
  @@index([sku])
}

model OrderStockAdjustment {
  id             String   @id @default(uuid())
  orderId        String   @unique
  orderNumber    String
  status         String   @default("pending")
  items          Json
  lastEventType  String
  lastEventAt    DateTime @default(now())
  managedById    String?
  managedByName  String?
  managedByEmail String?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([lastEventAt])
}

model OrderDecorationAttachment {
  id              String   @id @default(uuid())
  orderId         String   @unique
  files           Json     @default("[]")
  customerDesign  Json     @default("[]")
  customerRemarks String?
  photos          Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model BackInStockRequest {
  id                String               @id @default(uuid())
  orderId           String
  orderNumber       String
  requesterId       String
  requesterName     String
  requesterEmail    String
  status            String               @default("pending")
  items             Json
  requestMessage    String?
  requesterViewedAt DateTime?
  lastAdminUpdateAt DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  messages          BackInStockMessage[]

  @@index([orderId])
  @@index([requesterId])
  @@index([status])
  @@index([updatedAt])
}

model BackInStockMessage {
  id          String             @id @default(uuid())
  requestId   String
  senderId    String?
  senderName  String
  senderEmail String
  senderRole  String
  message     String
  status      String?
  createdAt   DateTime           @default(now())
  request     BackInStockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model OrderNote {
  id          String   @id @default(uuid())
  orderId     String
  note        String
  authorId    String?
  authorName  String?
  authorEmail String?
  editorId    String?
  editorName  String?
  editorEmail String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([authorEmail])
}

model OrderMessage {
  id          String           @id @default(uuid())
  orderId     String
  adminId     String?
  adminName   String
  adminEmail  String
  senderId    String?
  senderName  String?
  senderEmail String?
  type        OrderMessageType @default(orders)
  message     String
  createdAt   DateTime         @default(now())
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, type, createdAt])
  @@index([adminEmail])
}

enum OrderMessageType {
  orders
  picker
}

enum TaskStatus {
  PENDING
  COMPLETED
}

enum TaskDueType {
  STANDARD
  URGENT
  CUSTOM
}

enum TaskRecurrenceType {
  DAILY
  WEEKLY
}

model OrderSyncJob {
  id           String    @id @default(uuid())
  status       String    @default("queued")
  storeIds     Json?
  totalStores  Int       @default(0)
  totalFetched Int       @default(0)
  totalCreated Int       @default(0)
  totalUpdated Int       @default(0)
  failedStores Int       @default(0)
  error        String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([finishedAt])
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model Product {
  id               String           @id @default(uuid())
  storeId          String
  shopifyId        String
  title            String
  handle           String?
  vendor           String?
  productType      String?
  category         String?
  categoryId       String?
  status           ProductStatus    @default(ACTIVE)
  tags             String[]         @default([])
  imageUrl         String?
  descriptionHtml  String?
  images           Json?
  onlineStoreUrl   String?
  salesChannels    Json?
  totalInventory   Int              @default(0)
  soldQuantity     Int              @default(0)
  soldAmount       Decimal          @default(0) @db.Decimal(14, 2)
  shopifyCreatedAt DateTime?
  shopifyUpdatedAt DateTime?
  deletedAt        DateTime?
  store            Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants         ProductVariant[]
  lineItems        OrderLineItem[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([storeId, shopifyId])
  @@index([storeId, status])
  @@index([vendor])
  @@index([productType])
  @@index([category])
  @@index([storeId, title])
  @@index([handle])
}

model ProductVariant {
  id                String          @id @default(uuid())
  productId         String
  storeId           String
  shopifyId         String
  title             String?
  sku               String?
  price             Decimal         @default(0) @db.Decimal(14, 2)
  cost              Decimal?        @db.Decimal(14, 2)
  inventoryItemId   String?
  inventoryQuantity Int             @default(0)
  inventoryTracked  Boolean         @default(true)
  inventoryPolicy   String          @default("DENY")
  imageUrl          String?
  optionValues      Json?
  position          Int             @default(0)
  soldQuantity      Int             @default(0)
  soldAmount        Decimal         @default(0) @db.Decimal(14, 2)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  lineItems         OrderLineItem[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([storeId, shopifyId])
  @@index([productId])
  @@index([sku])
  @@index([storeId])
}

model OrderLineItem {
  id               String          @id @default(uuid())
  orderId          String
  storeId          String
  lineItemId       String
  productShopifyId String?
  variantShopifyId String?
  productId        String?
  variantId        String?
  sku              String?
  title            String?
  quantity         Int
  refundedQuantity Int             @default(0)
  netQuantity      Int             @default(0)
  unitPrice        Decimal         @default(0) @db.Decimal(14, 2)
  netAmount        Decimal         @default(0) @db.Decimal(14, 2)
  orderedAt        DateTime?
  canceled         Boolean         @default(false)
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  store            Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([orderId, lineItemId])
  @@index([productId, orderedAt])
  @@index([variantId, orderedAt])
  @@index([storeId])
  @@index([sku])
}

model ProductSyncJob {
  id           String    @id @default(uuid())
  status       String    @default("queued")
  storeIds     Json?
  totalStores  Int       @default(0)
  totalFetched Int       @default(0)
  totalCreated Int       @default(0)
  totalUpdated Int       @default(0)
  failedStores Int       @default(0)
  error        String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([finishedAt])
}

model AppSettings {
  id                                 String    @id @default("default")
  timezone                           String    @default("Australia/Sydney")
  staffAccessDays                    Json      @default("[\"Mon\",\"Tue\",\"Wed\",\"Thu\",\"Fri\"]")
  staffAccessStart                   String    @default("08:00")
  staffAccessEnd                     String    @default("16:00")
  sessionTimeoutMinutes              Int       @default(30)
  inactivityTimeoutMinutes           Int?
  googleEmail                        String?
  googleAccessToken                  String?
  googleRefreshToken                 String?
  googleTokenExpiresAt               DateTime?
  emailProvider                      String    @default("google")
  mailersendApiToken                 String?
  mailersendFromEmail                String?
  loginApprovalRecipientUserIds      Json      @default("[]")
  backInStockAdminRecipientUserIds   Json      @default("[]")
  stockAdjustmentRecipientUserIds    Json      @default("[]")
  fulfillmentRequestAllowedUserIds   Json      @default("[]")
  fulfillmentRequestDefaultUserIds   Json      @default("[]")
  pickingPackingAllowedUserIds       Json      @default("[]")
  pickingPackingDefaultUserIds       Json      @default("[]")
  directMessageAllowedUserIds        Json      @default("[]")
  directMessageDefaultUserIds        Json      @default("[]")
  backInStockRequesterUpdatesEnabled Boolean   @default(true)
  decorationDigestMode               String    @default("global_time")
  decorationDigestTime               String    @default("17:00")
  decorationDigestRecipientUserIds   Json      @default("[]")
  taskReminderTimes                  Json      @default("[\"08:00\",\"12:00\",\"16:00\"]")
  embroideryKeywords                 Json      @default("[\"embroider\",\"emb\"]")
  printKeywords                      Json      @default("[\"print\"]")
  seventrackApiKey                   String?
  trackingAutoRegisterEnabled        Boolean   @default(false)
  trackingPendingAlertDays           Int       @default(7)
  trackingPendingAlertUserIds        Json      @default("[]")
  trackingPickupReminderDays         Json      @default("[]")
  taskVisibilityByUser               Json      @default("{}")
  messageVisibilityByUser            Json      @default("{}")
  decorationCrossVisibilityEnabled   Boolean   @default(false)
  globalMarginPercent                Decimal   @default(0) @db.Decimal(6, 2)
  globalExchangeRate                 Decimal   @default(1) @db.Decimal(14, 6)
  lowStockThreshold                  Int       @default(10)
  invoicePrefix                      String    @default("INV-")
  invoiceNextNumber                  Int       @default(1000)
  createdAt                          DateTime  @default(now())
  updatedAt                          DateTime  @updatedAt
}

model FulfillmentEditRequest {
  id               String    @id @default(uuid())
  orderId          String
  orderNumber      String
  fulfillmentId    String
  requestType      String
  requestedById    String
  requestedByName  String
  requestedByEmail String
  reason           String
  status           String    @default("pending")
  adminTargets     Json
  approveToken     String    @unique
  rejectToken      String    @unique
  approvedById     String?
  approvedByName   String?
  approvedAt       DateTime?
  rejectedById     String?
  rejectedByName   String?
  rejectedAt       DateTime?
  completedAt      DateTime?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([orderId])
  @@index([fulfillmentId])
  @@index([status])
  @@index([requestedById])
  @@index([approveToken])
  @@index([rejectToken])
}

model Notification {
  id               String    @id @default(uuid())
  recipientId      String
  type             String
  title            String
  body             String
  orderId          String?
  orderNumber      String?
  lineItemId       String?
  relatedRequestId String?
  taskId           String?
  actionable       Boolean   @default(false)
  actionStatus     String?
  readAt           DateTime?
  createdAt        DateTime  @default(now())
  recipient        User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([recipientId, readAt])
  @@index([relatedRequestId])
  @@index([taskId])
}

model StaffLoginApproval {
  id           String    @id @default(uuid())
  userId       String
  email        String
  status       String    @default("pending")
  approveToken String    @unique
  rejectToken  String    @unique
  expiresAt    DateTime
  approvedAt   DateTime?
  rejectedAt   DateTime?
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
}

model ShipmentTracking {
  id                   String    @id @default(uuid())
  orderId              String
  storeId              String
  orderNumber          String
  trackingNumber       String
  carrier              Int?
  registrationStatus   String    @default("registered")
  status               String?
  subStatus            String?
  lastEventAt          DateTime?
  lastEventDesc        String?
  lastEventLocation    String?
  events               Json?
  shippedAt            DateTime?
  registeredAt         DateTime?
  availableForPickupAt DateTime?
  deliveredAt          DateTime?
  pendingAlertSentAt   DateTime?
  pickupRemindersSent  Json      @default("[]")
  lastSyncedAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  order                Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  store                Store     @relation(fields: [storeId], references: [id])

  @@unique([orderId, trackingNumber])
  @@index([trackingNumber])
  @@index([status])
  @@index([registrationStatus])
}

model BackgroundJob {
  id         String    @id @default(uuid())
  type       String
  payload    Json?
  status     String    @default("queued")
  attempts   Int       @default(0)
  error      String?
  progress   Json?
  runAfter   DateTime?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@index([runAfter])
  @@index([createdAt])
}

model Task {
  id                   String         @id @default(uuid())
  title                String
  description          String
  status               TaskStatus     @default(PENDING)
  dueDate              DateTime
  dueType              TaskDueType    @default(CUSTOM)
  completedAt          DateTime?
  proofFiles           Json           @default("[]")
  assignerId           String
  assignerName         String
  assignerEmail        String
  assigneeId           String
  assigneeName         String
  assigneeEmail        String
  lastReadByAssignerAt DateTime?
  lastReadByAssigneeAt DateTime?
  recurringTaskId      String?
  recurringTask        RecurringTask? @relation(fields: [recurringTaskId], references: [id], onDelete: SetNull)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  messages             TaskMessage[]

  @@index([assigneeId, status])
  @@index([assignerId])
  @@index([status, dueDate])
  @@index([createdAt])
  @@index([recurringTaskId])
}

model RecurringTask {
  id                String                  @id @default(uuid())
  title             String
  description       String
  dueType           TaskDueType
  dueDate           DateTime
  recurrenceType    TaskRecurrenceType
  recurrenceEndDate DateTime
  nextOccurrenceAt  DateTime
  stoppedAt         DateTime?
  assignerId        String
  assignerName      String
  assignerEmail     String
  assignees         RecurringTaskAssignee[]
  tasks             Task[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([stoppedAt, nextOccurrenceAt])
  @@index([assignerId])
}

model RecurringTaskAssignee {
  id              String        @id @default(uuid())
  recurringTaskId String
  assigneeId      String
  assigneeName    String
  assigneeEmail   String
  description     String
  createdAt       DateTime      @default(now())
  recurringTask   RecurringTask @relation(fields: [recurringTaskId], references: [id], onDelete: Cascade)

  @@unique([recurringTaskId, assigneeId])
  @@index([assigneeId])
}

model TaskMessage {
  id          String   @id @default(uuid())
  taskId      String
  senderId    String
  senderName  String
  senderEmail String
  message     String
  createdAt   DateTime @default(now())
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model Conversation {
  id                String        @id @default(uuid())
  user1Id           String
  user1Name         String
  user1Email        String
  user2Id           String
  user2Name         String
  user2Email        String
  lastMessageAt     DateTime?
  lastMessageText   String?
  lastReadByUser1At DateTime?
  lastReadByUser2At DateTime?
  unreadCountUser1  Int           @default(0)
  unreadCountUser2  Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  messages          ChatMessage[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model ChatMessage {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  senderName     String
  senderEmail    String
  message        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model CurrencyRate {
  id        String   @id @default(uuid())
  code      String   @unique
  rate      Decimal  @db.Decimal(14, 6)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GlobalColour {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model GlobalSize {
  id        String   @id @default(uuid())
  name      String   @unique
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model InventoryCategory {
  id        String            @id @default(uuid())
  name      String            @unique
  createdAt DateTime          @default(now())
  products  SupplierProduct[]
}

model Supplier {
  id             String                    @id @default(uuid())
  name           String
  contactEmail   String?
  poEmail        String
  description    String?
  productLinks   SupplierProductSupplier[]
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([name])
}

enum PurchaseOrderStatus {
  REQUESTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id                  String                 @id @default(uuid())
  number              Int                    @unique @default(autoincrement())
  referenceNumber     String?
  supplierId          String
  supplierName        String
  poEmail             String
  supplierProductId   String
  productTitle        String
  status              PurchaseOrderStatus    @default(REQUESTED)
  deliveryDate        DateTime?
  poRemark            String?
  shippingRemark      String?
  pricingCurrencyCode String?
  pricingExchangeRate Decimal?               @db.Decimal(14, 6)
  pricingBuyingPrice  Decimal?               @db.Decimal(14, 2)
  pricingFreight      Decimal?               @db.Decimal(14, 2)
  pricingMisc         Decimal?               @db.Decimal(14, 2)
  createdById         String
  createdByName       String
  statusUpdatedById   String?
  statusUpdatedByName String?
  statusUpdatedAt     DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  supplier            Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierProduct     SupplierProduct        @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  items               PurchaseOrderItem[]
  receipts            PurchaseOrderReceipt[]
  payment             PurchaseOrderPayment?

  @@index([supplierProductId, createdAt])
  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id               String                  @id @default(uuid())
  purchaseOrderId  String
  variantId        String?
  variantTitle     String
  sku              String?
  quantity         Int
  receivedQuantity Int                     @default(0)
  unitCost         Decimal?                @db.Decimal(14, 2)
  remark           String?
  purchaseOrder    PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant          SupplierProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([purchaseOrderId, variantId])
  @@index([purchaseOrderId])
}

model PurchaseOrderReceipt {
  id              String        @id @default(uuid())
  purchaseOrderId String
  locationName    String?
  quantity        Int
  receivedById    String?
  receivedByName  String?
  createdAt       DateTime      @default(now())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

enum PoPaymentStatus {
  UNPAID
  PAID
}

model PurchaseOrderPayment {
  id              String                        @id @default(uuid())
  purchaseOrderId String                        @unique
  status          PoPaymentStatus               @default(UNPAID)
  currencyCode    String
  exchangeRate    Decimal                       @db.Decimal(14, 6)
  buyingPrice     Decimal                       @db.Decimal(14, 2)
  freight         Decimal                       @default(0) @db.Decimal(14, 2)
  misc            Decimal                       @default(0) @db.Decimal(14, 2)
  totalAud        Decimal                       @db.Decimal(14, 2)
  paidAt          DateTime?
  reference       String?
  remark          String?
  createdById     String
  createdByName   String
  updatedById     String
  updatedByName   String
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  purchaseOrder   PurchaseOrder                 @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  history         PurchaseOrderPaymentHistory[]

  @@index([status])
}

model PurchaseOrderPaymentHistory {
  id           String               @id @default(uuid())
  paymentId    String
  action       String
  status       PoPaymentStatus
  currencyCode String
  exchangeRate Decimal              @db.Decimal(14, 6)
  buyingPrice  Decimal              @db.Decimal(14, 2)
  freight      Decimal              @db.Decimal(14, 2)
  misc         Decimal              @db.Decimal(14, 2)
  totalAud     Decimal              @db.Decimal(14, 2)
  paidAt       DateTime?
  reference    String?
  remark       String?
  actorId      String
  actorName    String
  createdAt    DateTime             @default(now())
  payment      PurchaseOrderPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@index([createdAt])
}

model InventoryLocation {
  id               String                           @id @default(uuid())
  name             String                           @unique
  description      String?
  variants         SupplierProductVariantLocation[]
  stocktakeItems   StocktakeItem[]
  stockAdjustments StockAdjustment[]
  storeLocations   StoreLocation[]
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt
}

model StoreLocation {
  id                  String             @id @default(uuid())
  storeId             String
  shopifyLocationId   String
  name                String
  active              Boolean            @default(true)
  inventoryLocationId String?
  store               Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inventoryLocation   InventoryLocation? @relation(fields: [inventoryLocationId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([storeId, shopifyLocationId])
  @@index([inventoryLocationId])
}

model SupplierProductVariantLocation {
  variantId  String
  locationId String
  quantity   Int                    @default(0)
  createdAt  DateTime               @default(now())
  variant    SupplierProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location   InventoryLocation      @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([variantId, locationId])
  @@index([locationId])
}

enum SupplierProductStatus {
  ACTIVE
  DRAFT
  UNLISTED
}

model SupplierProduct {
  id                  String                        @id @default(uuid())
  itemNo              String                        @unique
  handle              String                        @unique
  name                String
  brand               String?
  category            String?
  categoryId          String?
  inventoryCategoryId String?
  inventoryCategory   InventoryCategory?            @relation(fields: [inventoryCategoryId], references: [id], onDelete: SetNull)
  sku                 String
  description         String?
  productRemark       String?
  poQuantity          Int                           @default(1)
  omitted             Boolean                       @default(false)
  status              SupplierProductStatus         @default(DRAFT)
  verified            Boolean                       @default(false)
  sizes               String[]                      @default([])
  colours             Json                          @default("[]")
  nextStocktakeAt     DateTime?
  supplierLinks       SupplierProductSupplier[]
  variants            SupplierProductVariant[]
  images              SupplierProductImage[]
  pricing             SupplierProductPricing?
  purchaseOrders      PurchaseOrder[]
  stocktakes          Stocktake[]
  adjustments         StockAdjustment[]
  adjustmentBatches   StockAdjustmentBatch[]
  activity            InventoryActivity[]
  storeListings       SupplierProductStoreListing[]
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  @@index([createdAt])
  @@index([name])
  @@index([sku])
  @@index([inventoryCategoryId])
}

model SupplierProductSupplier {
  id                String          @id @default(uuid())
  supplierProductId String
  supplierId        String
  createdAt         DateTime        @default(now())
  supplierProduct   SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  supplier          Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierProductId, supplierId])
  @@index([supplierId])
}

model SupplierProductVariant {
  id                String  @id @default(uuid())
  supplierProductId String
  sku               String?
  barcode           String?
  colour            String
  size              String
  stockOnHand       Int     @default(0)

  allocated Int     @default(0)
  buyPrice  Decimal @default(0) @db.Decimal(14, 2)
  sellPrice Decimal @default(0) @db.Decimal(14, 2)
  trigger   Int     @default(10)

  forwardOrders Int @default(0)
  position      Int @default(0)

  imageId            String?
  image              SupplierProductImage?            @relation(fields: [imageId], references: [id], onDelete: SetNull)
  supplierProduct    SupplierProduct                  @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  purchaseOrderItems PurchaseOrderItem[]
  locations          SupplierProductVariantLocation[]
  stocktakeItems     StocktakeItem[]
  adjustments        StockAdjustment[]
  storeVariants      SupplierProductStoreVariant[]
  allocations        InventoryAllocation[]
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt

  @@unique([supplierProductId, colour, size])
  @@index([supplierProductId])
  @@index([sku])
  @@index([barcode])
  @@index([imageId])
}

model SupplierProductImage {
  id                String                   @id @default(uuid())
  supplierProductId String
  url               String
  /// Original remote URL this image was downloaded from (CSV import); `url` is then our own copy.
  sourceUrl         String?
  altText           String?
  colour            String?
  position          Int                      @default(0)
  supplierProduct   SupplierProduct          @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  variants          SupplierProductVariant[]
  createdAt         DateTime                 @default(now())

  @@index([supplierProductId])
  @@index([sourceUrl])
  @@index([url])
}

model SupplierProductPricing {
  id                String          @id @default(uuid())
  supplierProductId String          @unique
  currencyCode      String          @default("USD")
  exchangeRate      Decimal         @default(1) @db.Decimal(14, 6)
  buyingPrice       Decimal         @default(0) @db.Decimal(14, 2)
  freight           Decimal         @default(0) @db.Decimal(14, 2)
  misc              Decimal         @default(0) @db.Decimal(14, 2)
  marginPercent     Decimal         @default(0) @db.Decimal(6, 2)
  tax               Decimal         @default(10) @db.Decimal(6, 2)
  supplierProduct   SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

enum StocktakeStatus {
  OPEN
  COUNTED
  COMPLETED
  CANCELLED
}

model Stocktake {
  id                String          @id @default(uuid())
  number            Int             @unique @default(autoincrement())
  supplierProductId String
  status            StocktakeStatus @default(OPEN)
  startedById       String
  startedByName     String
  countedById       String?
  countedByName     String?
  countedAt         DateTime?
  syncedById        String?
  syncedByName      String?
  completedAt       DateTime?
  supplierProduct   SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  items             StocktakeItem[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([supplierProductId, createdAt])
  @@index([status, createdAt])
}

model StocktakeItem {
  id           String                 @id @default(uuid())
  stocktakeId  String
  variantId    String
  locationId   String?
  locationName String?
  expectedQty  Int
  countedQty   Int?
  stocktake    Stocktake              @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  variant      SupplierProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location     InventoryLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([stocktakeId])
  @@index([variantId])
  @@index([locationId])
}

enum StockAdjustmentReason {
  DAMAGED
  LOST
  FOUND
  RETURN
  CORRECTION
  OTHER
}

enum StockAdjustmentSource {
  MANUAL
  STOCKTAKE
}

model StockAdjustmentBatch {
  id                String                @id @default(uuid())
  number            Int                   @unique @default(autoincrement())
  supplierProductId String
  source            StockAdjustmentSource @default(MANUAL)
  reference         String?
  actorId           String
  actorName         String
  supplierProduct   SupplierProduct       @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  lines             StockAdjustment[]
  createdAt         DateTime              @default(now())

  @@index([supplierProductId, createdAt])
  @@index([createdAt])
}

model StockAdjustment {
  id                String                 @id @default(uuid())
  batchId           String
  batch             StockAdjustmentBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  supplierProductId String
  variantId         String
  delta             Int
  stockBefore       Int?
  locationId        String?
  locationName      String?
  reason            StockAdjustmentReason
  note              String?
  actorId           String
  actorName         String
  supplierProduct   SupplierProduct        @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  variant           SupplierProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location          InventoryLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdAt         DateTime               @default(now())

  @@index([supplierProductId, createdAt])
  @@index([variantId])
  @@index([batchId])
  @@index([locationId])
}

model InventoryActivity {
  id                String          @id @default(uuid())
  supplierProductId String
  variantId         String?
  type              String
  message           String
  actorId           String?
  actorName         String
  adjustmentBatchId String?
  supplierProduct   SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@index([supplierProductId, createdAt])
}

enum StoreListingStatus {
  NOT_LISTED
  PUBLISHING
  LISTED
  FAILED
}

model SupplierProductStoreListing {
  id                String                        @id @default(uuid())
  supplierProductId String
  storeId           String
  productGid        String?
  externalId        String?
  handle            String?
  status            StoreListingStatus            @default(NOT_LISTED)
  shopifyStatus     String?
  marginPercent     Decimal?                      @db.Decimal(6, 2)
  lastError         String?
  lastPublishedAt   DateTime?
  lastSyncedAt      DateTime?
  supplierProduct   SupplierProduct               @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  store             Store                         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants          SupplierProductStoreVariant[]
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  @@unique([supplierProductId, storeId])
  @@index([storeId])
}

model SupplierProductStoreVariant {
  id               String                      @id @default(uuid())
  listingId        String
  variantId        String
  variantGid       String?
  inventoryItemGid String?
  price            Decimal?                    @db.Decimal(14, 2)
  listing          SupplierProductStoreListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  variant          SupplierProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@unique([listingId, variantId])
  @@index([variantId])
}

model ShopifyWebhookEvent {
  id          String    @id @default(uuid())
  storeId     String
  webhookId   String
  topic       String
  status      String    @default("processing")
  error       String?
  processedAt DateTime?
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([storeId, webhookId])
  @@index([topic, createdAt])
}

enum InventoryAllocationState {
  ALLOCATED
  FULFILLED
  RELEASED
}

model InventoryAllocation {
  id                String                   @id @default(uuid())
  storeId           String
  orderId           String?
  shopifyOrderId    String
  orderNumber       Int?
  lineItemId        String
  sku               String?
  variantId         String?
  quantity          Int
  fulfilledQuantity Int                      @default(0)
  releasedQuantity  Int                      @default(0)
  refundedQuantity  Int                      @default(0)
  state             InventoryAllocationState @default(ALLOCATED)
  store             Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order             Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  variant           SupplierProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([storeId, shopifyOrderId, lineItemId])
  @@index([variantId])
  @@index([state])
  @@index([sku])
}

model ProcessedFulfillmentEvent {
  id             String   @id @default(uuid())
  storeId        String
  shopifyOrderId String
  fulfillmentId  String
  lineItemId     String
  status         String   @default("applied")
  appliedQty     Int      @default(0)
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([storeId, fulfillmentId, lineItemId])
  @@index([storeId, shopifyOrderId])
}

model ProcessedRefundEvent {
  id             String   @id @default(uuid())
  storeId        String
  shopifyOrderId String
  refundId       String
  lineItemId     String
  quantity       Int      @default(0)
  restockType    String?
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([storeId, refundId, lineItemId])
  @@index([storeId, shopifyOrderId])
}
