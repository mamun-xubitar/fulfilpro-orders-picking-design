// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  password       String
  role           String   @default("admin")
  active         Boolean  @default(true)
  isTempPassword Boolean  @default(true)
  isLoggedIn     Boolean  @default(false)
  lastLoginAt    DateTime?
  lastLogoutAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  staffLoginApprovals StaffLoginApproval[]

  @@index([email])
  @@index([active])
  @@index([isLoggedIn])
}

model Store {
  id             String   @id @default(uuid())
  storeDomain    String   @unique
  name           String?
  accessToken    String?
  url            String?
  email          String?
  logoPath       String?
  status         String   @default("pending")
  clientId       String
  clientSecret   String
  partnerStoreId String?
  partnerStore   Store?   @relation("PartnerStores", fields: [partnerStoreId], references: [id], onDelete: SetNull)
  childStores    Store[]  @relation("PartnerStores")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]

  @@index([status])
  @@index([partnerStoreId])
}

model Order {
  id                String    @id @default(uuid())
  number            String    @unique
  cusName           String
  cusEmail          String?
  address           String?
  address2          String?
  phone             String?
  city              String?
  canceledAt        DateTime?
  closedAt          DateTime?
  canceled          Boolean   @default(false)
  closed            Boolean   @default(false)
  state             String?
  zip               String?
  fulfillmentStatus String?
  boarcode          String?
  currencyCode      String?
  note              String?
  lineItems         Json
  fulfillmentItems  Json?
  price             Float
  country           String?
  storeId           String
  orderedAt         DateTime?
  store             Store     @relation(fields: [storeId], references: [id])
  messages          OrderMessage[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model OrderMessage {
  id          String   @id @default(uuid())
  orderId     String
  adminId     String?
  adminName   String
  adminEmail  String
  senderId    String?
  senderName  String?
  senderEmail String?
  message     String
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([adminEmail])
}

model OrderSyncJob {
  id              String    @id @default(uuid())
  status          String    @default("queued")
  windowStartedAt DateTime
  windowEndedAt   DateTime
  totalStores     Int       @default(0)
  totalFetched    Int       @default(0)
  totalCreated    Int       @default(0)
  totalUpdated    Int       @default(0)
  failedStores    Int       @default(0)
  error           String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([finishedAt])
}

model AppSettings {
  id                    String   @id @default("default")
  timezone              String   @default("Australia/Sydney")
  staffAccessDays       Json     @default("[\"Mon\",\"Tue\",\"Wed\",\"Thu\",\"Fri\"]")
  staffAccessStart      String   @default("08:00")
  staffAccessEnd        String   @default("16:00")
  sessionTimeoutMinutes        Int      @default(30)
  inactivityTimeoutMinutes     Int?
  googleEmail           String?
  googleAccessToken     String?
  googleRefreshToken    String?
  googleTokenExpiresAt  DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model FulfillmentEditRequest {
  id               String    @id @default(uuid())
  orderId          String
  orderNumber      String
  fulfillmentId    String
  requestType      String
  requestedById    String
  requestedByName  String
  requestedByEmail String
  reason           String
  status           String    @default("pending")
  adminTargets     Json
  approveToken     String    @unique
  rejectToken      String    @unique
  approvedById     String?
  approvedByName   String?
  approvedAt       DateTime?
  rejectedById     String?
  rejectedByName   String?
  rejectedAt       DateTime?
  completedAt      DateTime?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([orderId])
  @@index([fulfillmentId])
  @@index([status])
  @@index([requestedById])
  @@index([approveToken])
  @@index([rejectToken])
}

model StaffLoginApproval {
  id           String    @id @default(uuid())
  userId       String
  email        String
  status       String    @default("pending")
  approveToken String    @unique
  rejectToken  String    @unique
  expiresAt    DateTime
  approvedAt   DateTime?
  rejectedAt   DateTime?
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
}
