// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  password       String
  role           String   @default("admin")
  isTempPassword Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([email])
}

model Store {
  id           String   @id @default(uuid())
  storeDomain  String   @unique
  name         String?
  accessToken  String?
  url          String?
  email        String?
  status       String   @default("pending")
  clientId     String
  clientSecret String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]

  @@index([status])
}

model Order {
  id                String    @id @default(uuid())
  number            String    @unique
  cusName           String
  cusEmail          String?
  address           String?
  address2          String?
  phone             String?
  city              String?
  canceledAt        DateTime?
  closedAt          DateTime?
  canceled          Boolean   @default(false)
  closed            Boolean   @default(false)
  state             String?
  zip               String?
  fulfillmentStatus String?
  boarcode          String?
  currencyCode      String?
  lineItems         Json
  fulfillmentItems  Json?
  price             Float
  country           String?
  storeId           String
  orderedAt         DateTime?
  store             Store     @relation(fields: [storeId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model AppSettings {
  id                    String   @id @default("default")
  timezone              String   @default("Australia/Sydney")
  staffAccessDays       Json     @default("[\"Mon\",\"Tue\",\"Wed\",\"Thu\",\"Fri\"]")
  staffAccessStart      String   @default("08:00")
  staffAccessEnd        String   @default("16:00")
  sessionTimeoutMinutes Int      @default(30)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
